# Environment variables for production (Phase 11). Copy to .env (gitignored) or
# set these in your platform's secret manager. Every FAP_* var overrides the
# matching config key; double underscore (__) descends into a nested section.
#
# SECRETS LIVE HERE, NOT IN YAML. The app reads them at boot; scripts/health_check.py
# --config validates that the ones your chosen backends need are present.

# --- Database: libSQL / Turso ------------------------------------------------
FAP_DATABASE__BACKEND=libsql
FAP_DATABASE__URL=libsql://your-db.turso.io
FAP_DATABASE__AUTH_TOKEN=            # SECRET: Turso database token
FAP_DATABASE__POOL_SIZE=5

# --- Object storage: S3 / R2 / B2 / MinIO ------------------------------------
FAP_STORAGE__BACKEND=s3
FAP_STORAGE__BUCKET=fap-assets
FAP_STORAGE__ENDPOINT_URL=           # e.g. https://<acct>.r2.cloudflarestorage.com (empty for AWS)
FAP_STORAGE__REGION=auto
FAP_STORAGE__ACCESS_KEY_ID=          # SECRET
FAP_STORAGE__SECRET_ACCESS_KEY=      # SECRET

# --- Cache: Redis ------------------------------------------------------------
FAP_CACHE__BACKEND=redis
FAP_CACHE__REDIS_URL=                # SECRET: rediss://:password@host:6379/0

# --- Identity / deployment ---------------------------------------------------
FAP_SUPER_ADMIN=admin@yourclub.com   # bootstrap owner email
FAP_BASE_URL=https://analysis.yourclub.com

# --- Optional: Microsoft Graph email (invitations) ---------------------------
# FAP_GRAPH_TENANT=
# FAP_GRAPH_CLIENT_ID=
# FAP_GRAPH_CLIENT_SECRET=           # SECRET
# FAP_GRAPH_SENDER=
